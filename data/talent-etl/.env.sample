# Copy to .env and `set -a; source .env; set +a` to override defaults.
# Local runs work with no variables set; cloud runs (IS_LOCAL=false) need all of these.
IS_LOCAL=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_NAME=talent_mgmt
POSTGRES_USER=postgres
POSTGRES_PASS=postgres123
# Local directory or s3://bucket/prefix
LAKE_ROOT=./lake
# Root of the year=/month=/day= learning activity partitions (local dir or s3://)
EVENTS_SOURCE_URI=../../sampleData/data-engineering-sample-performance-scenario/data-engineering-performance-talent-management/learning_activity
# Bronze snapshot partition; defaults to today (UTC). Set to backfill or rerun a past date.
RUN_DATE=
LOG_LEVEL=INFO
